{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StripBot Marketplace Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "plugins",
    "mcpServers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mcp"
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "repository"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github[.]com/"
        }
      },
      "additionalProperties": false
    },
    "plugin": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "manifest"
          ],
          "properties": {
            "manifest": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "mcp": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint",
            "access"
          ],
          "properties": {
            "transport": {
              "const": "streamable-http"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https://"
            },
            "access": {
              "enum": [
                "public-read",
                "authenticated"
              ]
            }
          }
        }
      ]
    }
  }
}
